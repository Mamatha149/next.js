trigger:
- main

pool:
  vmImage: ubuntu-latest

steps:

- task: NodeTool@0
  inputs:
    versionSpec: '18.x'

- script: npm install
  displayName: Install

- script: npm run build
  displayName: Build

- task: AzureWebApp@1
  inputs:
    azureSubscription: 'Azure subscription 1'
    appName: 'mamatha-nextjs-app'
    package: '.'
